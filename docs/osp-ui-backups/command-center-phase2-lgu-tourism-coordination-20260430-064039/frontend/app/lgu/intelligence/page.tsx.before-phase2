"use client";

import { useEffect, useMemo, useState } from "react";
import CommandCenterShell from "../../../src/components/intelligence/CommandCenterShell";
import { SIARGAO_MUNICIPALITIES } from "../../../src/lib/siargaoMunicipalities";

function getApiBaseUrl() {
  const explicit = process.env.NEXT_PUBLIC_API_BASE_URL;
  if (explicit) return explicit.replace(/\/$/, "");
  return "http://localhost:8001/api/v1";
}

export default function LguIntelligencePage() {
  const apiBaseUrl = useMemo(() => getApiBaseUrl(), []);
  const [municipality, setMunicipality] = useState("ALL_SIARGAO");
  const [data, setData] = useState<any>(null);
  const [error, setError] = useState("");

  useEffect(() => {
    async function loadData() {
      try {
        const response = await fetch(
          `${apiBaseUrl}/lgu/intelligence/overview?municipality=${municipality}`,
          { cache: "no-store" }
        );
        const json = await response.json();
        if (!response.ok || !json?.ok) {
          setError(json?.message || "Unable to load LGU command center.");
          return;
        }
        setData(json);
        setError("");
      } catch {
        setError("Unable to reach the OSP API. Please make sure the backend is running and try again.");
      }
    }
    loadData();
  }, [apiBaseUrl, municipality]);

  const navItems = [
    { label: "Overview", active: true },
    { label: "Movement Intelligence" },
    { label: "Compliance Intelligence" },
    { label: "Operator Participation" },
    { label: "Partner Readiness" },
    { label: "Passport Trails Intelligence" },
    { label: "Safety & Event Intelligence" },
    { label: "Municipality View" },
    { label: "Governance Boundary" },
  ];

  return (
    <CommandCenterShell
      productName="LGU Destination Intelligence Command Center"
      productSubtitle="Role-scoped operational intelligence for destination governance across Siargao."
      navItems={navItems}
      municipality={municipality}
      municipalities={[...SIARGAO_MUNICIPALITIES]}
      onMunicipalityChange={setMunicipality}
    >
      {error ? <div className="osp-command-alert">{error}</div> : null}
      {!data ? (
        <div className="osp-command-panel">Loading command center...</div>
      ) : (
        <>
          <section className="osp-command-card-grid">
            {(data.summaryCards || []).map((card: any) => (
              <article className="osp-command-card" key={card.label}>
                <p>{card.label}</p>
                <strong>{card.value}</strong>
                <span>{card.helper}</span>
                <small>{card.visibility || "LGU_SAFE"} · {card.dataClass || "AGGREGATED"}</small>
              </article>
            ))}
          </section>

          <h3 className="osp-command-section-title">System Gauges</h3>
          <section className="osp-command-gauge-grid">
            {(data.gauges || []).map((gauge: any) => (
              <article className="osp-command-panel osp-command-gauge" key={gauge.label}>
                <div className="osp-command-gauge-ring" style={{ ["--gauge-value" as any]: gauge.value }}>
                  <div className="osp-command-gauge-inner">{gauge.value}%</div>
                </div>
                <h4>{gauge.label}</h4>
                <span>{gauge.status}</span>
                <p>{gauge.interpretation}</p>
              </article>
            ))}
          </section>

          <h3 className="osp-command-section-title">Inter-Layer Intelligence Matrix</h3>
          <section className="osp-command-table">
            {(data.intelligenceLayers || []).map((layer: any) => (
              <div className="osp-command-table-row" key={layer.layer}>
                <div>
                  <strong>{layer.layer}</strong>
                  <span>{layer.spineStatus}</span>
                </div>
                <div>{layer.records}</div>
                <div>{(layer.parameters || []).join(" · ")}</div>
                <div>{layer.lguOutput}</div>
              </div>
            ))}
          </section>

          <h3 className="osp-command-section-title">Governance Boundary</h3>
          <section className="osp-command-panel">
            <div className="osp-command-pill-grid">
              {(data.governanceBoundaries || []).map((item: string) => (
                <div className="osp-command-pill" key={item}>{item}</div>
              ))}
            </div>
          </section>
        </>
      )}
    </CommandCenterShell>
  );
}
