type MarketplacePayload = {
  ok: boolean;
  mode: string;
  generatedAt: string;
  contract?: {
    endpoint?: string;
    bookingExecutionIncluded?: boolean;
    paymentExecutionIncluded?: boolean;
    frontendSourceOfTruthReady?: boolean;
    premiumFieldsIncluded?: string[];
    premiumFieldTruthStatus?: string;
    productionVisibilityPolicy?: Record<string, unknown>;
    note?: string;
  };
  counts?: {
    total?: number;
    spmPackages?: number;
    operatorActivities?: number;
  };
  services?: MarketplaceService[];
};

const API_BASE = process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:8001/api/v1";

async function getMarketplaceServices(): Promise<MarketplacePayload> {
  try {
    const res = await fetch(`${API_BASE}/traveler/marketplace/services?limit=24`, {
      cache: "no-store",
      headers: {
        "Content-Type": "application/json",
      },
    });

    if (!res.ok) {
      return {
        ok: false,
        mode: "MARKETPLACE_FETCH_FAILED",
        generatedAt: new Date().toISOString(),
        counts: { total: 0, spmPackages: 0, operatorActivities: 0 },
        services: [],
      };
    }

    return await res.json();
  } catch {
    return {
      ok: false,
      mode: "MARKETPLACE_BACKEND_UNAVAILABLE",
      generatedAt: new Date().toISOString(),
      counts: { total: 0, spmPackages: 0, operatorActivities: 0 },
      services: [],
    };
  }
}

function getCtaLabel(service: MarketplaceService) {
  const cta = service.booking?.ctaMode;

  if (cta === "START_ISLAND_HOPPING_REQUEST") return "Start Island Hopping Request";
  if (cta === "REQUEST_AVAILABILITY") return "Check Availability";
  if (cta === "ADD_TO_TRAIL") return "Add to My Passport Trail";
  if (cta === "COMING_SOON") return "Get Notified";

  return "View Experience Details";
}

function getCtaMicrocopy(service: MarketplaceService) {
  const cta = service.booking?.ctaMode;

  if (cta === "START_ISLAND_HOPPING_REQUEST") {
    return "Regulated island trips require operator coordination, manifest readiness, and clearance flow.";
  }

  if (cta === "REQUEST_AVAILABILITY") {
    return "Send a structured request before payment or operator assignment is created.";
  }

  if (cta === "ADD_TO_TRAIL") {
    return "Save this experience into your Passport Trail planning flow.";
  }

  return "Review details before choosing your next Siargao experience.";
}

function getServiceIcon(service: MarketplaceService) {
  if (service.media?.icon) return service.media.icon;
  if (service.category === "ISLAND_HOPPING") return "🏝️";
  if (service.category === "SURF") return "🏄";
  if (service.category === "LAND_TOUR") return "🚐";
  if (service.category === "PASSPORT_TRAIL") return "🗺️";
  if (service.category === "CULTURE") return "🤝";
  if (service.category === "SCENIC") return "🌅";
  return "✨";
}

function formatCategory(value?: string) {
  return String(value || "PARTNER_EXPERIENCE").replace(/_/g, " ");
}

