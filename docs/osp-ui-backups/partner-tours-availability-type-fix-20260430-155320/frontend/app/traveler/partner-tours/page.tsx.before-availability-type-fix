            Choose experiences with confidence. Island Hopping starts a regulated request flow; operator-led services must pass accreditation, quality, and fair exposure gates before appearing here. Featured placement is governed; sponsored placement is not active yet.
          </p>
        </section>

        <section id="marketplace-services" aria-label="Verified partner services" style={{ marginTop: 14, display: "grid", gap: 12 }}>
          {services.length > 0 ? (
            services.map((service) => <ServiceCard key={service.id} service={service} />)
          ) : (
            <div
              style={{
                borderRadius: 30,
                padding: 18,
                background: "rgba(255,255,255,0.92)",
                border: "1px solid rgba(47,127,178,0.16)",
                boxShadow: "0 18px 44px rgba(19,79,127,0.10)",
              }}
            >
              <div style={{ fontSize: 11, fontWeight: 950, letterSpacing: "0.12em", color: "#137d82", textTransform: "uppercase" }}>
                No services live yet
              </div>
              <h2 style={{ margin: "6px 0 0", color: "#0b355f", fontSize: 22, lineHeight: 1.05, fontWeight: 950 }}>
                Waiting for approved partner experiences.
              </h2>
              <p style={{ margin: "8px 0 0", color: "rgba(16,35,63,0.70)", fontSize: 13, lineHeight: 1.45, fontWeight: 700 }}>
                Operator-created services will appear here only after visibility, quality, and accreditation requirements are satisfied.
              </p>
            </div>
          )}
        </section>

        <section
          aria-label="Marketplace governance"
          style={{
            marginTop: 14,
            borderRadius: 28,
            padding: 15,
            background: "rgba(255,255,255,0.84)",
            border: "1px solid rgba(47,127,178,0.14)",
          }}
        >
          <div style={{ fontSize: 11, fontWeight: 950, letterSpacing: "0.12em", color: "#137d82", textTransform: "uppercase" }}>
            Governance
          </div>
          <p style={{ margin: "7px 0 0", color: "rgba(16,35,63,0.70)", fontSize: 12.5, lineHeight: 1.45, fontWeight: 700 }}>
            {productionPolicy
              ? "Traveler-visible services are filtered by public visibility, service quality, operator status, DOT/accreditation policy, and governed exposure logic. Sponsored placement is not active yet."
              : "Marketplace policy is loading from the backend contract."}
          </p>
        </section>

        <section
          aria-label="Sticky actions"
          style={{
            position: "fixed",
            left: 0,
            right: 0,
            bottom: 0,
            zIndex: 20,
            padding: "10px 13px 14px",
            background: "linear-gradient(180deg, rgba(248,250,252,0), rgba(248,250,252,0.96) 24%, rgba(248,250,252,1))",
            borderTop: "1px solid rgba(14,116,144,0.08)",
          }}
        >
          <div
            style={{
              maxWidth: 460,
              margin: "0 auto",
              display: "grid",
              gridTemplateColumns: "1fr 1fr 1fr",
              gap: 7,
            }}
          >
            <a href="/traveler/passport-trails" style={stickyLinkStyle}>Official Trails</a>
            <a href="/traveler/passport-trails/diy-trail-builder" style={stickyPrimaryStyle}>Build Trail</a>
            <a href="/traveler/passport-map" style={stickyLinkStyle}>Passport Map</a>
          </div>
        </section>
      </div>
    </main>
  );
}

