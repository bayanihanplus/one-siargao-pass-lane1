
/* ============================================================
   OSP PUBLIC WEBSITE REAL CSS FOUNDATION
   No Tailwind dependency.
   ============================================================ */

.osp-public-root {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(16, 185, 129, 0.16), transparent 34%),
    radial-gradient(circle at bottom right, rgba(245, 158, 11, 0.14), transparent 30%),
    #f7f1e6;
  color: #0f172a;
  font-family: var(--font-geist-sans, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
}

.osp-public-header {
  position: sticky;
  top: 0;
  z-index: 40;
  border-bottom: 1px solid rgba(6, 78, 59, 0.12);
  background: rgba(255, 250, 240, 0.96);
  backdrop-filter: blur(14px);
}

.osp-public-header-inner {
  width: min(100%, 1180px);
  margin: 0 auto;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.osp-public-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: #064e3b;
}

.osp-public-brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: #064e3b;
  color: #fef3c7;
  font-weight: 950;
  font-size: 13px;
  box-shadow: 0 10px 24px rgba(6, 78, 59, 0.18);
}

.osp-public-brand-title {
  margin: 0;
  font-size: 13px;
  font-weight: 950;
  letter-spacing: 0.18em;
  color: #064e3b;
}

.osp-public-brand-subtitle {
  margin: 3px 0 0;
  font-size: 12px;
  font-weight: 700;
  color: rgba(15, 23, 42, 0.58);
}

.osp-public-nav {
  display: flex;
  align-items: center;
  gap: 18px;
}

.osp-public-nav a {
  text-decoration: none;
  color: rgba(15, 23, 42, 0.78);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.osp-public-nav a:hover {
  color: #064e3b;
}

.osp-public-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.osp-public-mobile-nav {
  display: none;
  border-top: 1px solid rgba(6, 78, 59, 0.08);
  padding: 10px 20px;
  overflow-x: auto;
  gap: 8px;
}

.osp-public-mobile-nav a {
  flex: 0 0 auto;
  text-decoration: none;
  border: 1px solid rgba(6, 78, 59, 0.14);
  background: rgba(255, 255, 255, 0.78);
  color: rgba(15, 23, 42, 0.78);
  border-radius: 999px;
  padding: 9px 12px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.osp-public-hero {
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid rgba(6, 78, 59, 0.1);
}

.osp-public-hero-inner {
  width: min(100%, 1180px);
  margin: 0 auto;
  padding: 72px 20px;
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
  align-items: center;
  gap: 48px;
}

.osp-public-eyebrow {
  margin: 0 0 18px;
  color: #047857;
  font-size: 12px;
  font-weight: 950;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

.osp-public-title {
  margin: 0;
  max-width: 900px;
  color: #064e3b;
  font-size: clamp(44px, 6vw, 78px);
  line-height: 0.92;
  letter-spacing: -0.07em;
  font-weight: 950;
}

.osp-public-subtitle {
  margin: 26px 0 0;
  max-width: 760px;
  color: rgba(15, 23, 42, 0.72);
  font-size: clamp(17px, 2vw, 21px);
  line-height: 1.65;
}

.osp-public-cta-row {
  margin-top: 34px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.osp-public-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  border-radius: 999px;
  padding: 0 22px;
  text-decoration: none;
  border: 1px solid transparent;
  font-size: 14px;
  font-weight: 950;
}

.osp-public-button-primary {
  background: #064e3b;
  color: #fef3c7;
  box-shadow: 0 12px 28px rgba(6, 78, 59, 0.18);
}

.osp-public-button-secondary {
  background: rgba(255, 255, 255, 0.82);
  color: #064e3b;
  border-color: rgba(6, 78, 59, 0.18);
}

.osp-public-button-light {
  background: #fef3c7;
  color: #064e3b;
}

.osp-public-info-card {
  border: 1px solid rgba(6, 78, 59, 0.12);
  background: rgba(255, 255, 255, 0.78);
  border-radius: 34px;
  padding: 20px;
  box-shadow: 0 24px 70px rgba(6, 78, 59, 0.1);
}

.osp-public-info-card-main {
  border-radius: 26px;
  background: #064e3b;
  color: #fff7ed;
  padding: 24px;
}

.osp-public-info-card-main p {
  margin: 0;
}

.osp-public-info-label {
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #fde68a;
}

.osp-public-info-title {
  margin-top: 16px !important;
  font-size: 30px;
  line-height: 1;
  letter-spacing: -0.05em;
  font-weight: 950;
}

.osp-public-info-body {
  margin-top: 14px !important;
  color: rgba(254, 243, 199, 0.86);
  font-size: 14px;
  line-height: 1.65;
}

.osp-public-quick-grid {
  margin-top: 14px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.osp-public-quick-card {
  display: block;
  text-decoration: none;
  border: 1px solid rgba(6, 78, 59, 0.1);
  background: #fffaf0;
  border-radius: 20px;
  padding: 16px;
}

.osp-public-quick-card strong {
  display: block;
  color: #064e3b;
  font-size: 14px;
}

.osp-public-quick-card span {
  display: block;
  margin-top: 4px;
  color: rgba(15, 23, 42, 0.55);
  font-size: 12px;
  font-weight: 700;
}

.osp-public-section {
  width: min(100%, 1180px);
  margin: 0 auto;
  padding: 56px 20px;
}

.osp-public-section-title {
  margin: 0;
  max-width: 840px;
  color: #064e3b;
  font-size: clamp(32px, 4.2vw, 52px);
  line-height: 1;
  letter-spacing: -0.055em;
  font-weight: 950;
}

.osp-public-section-body {
  margin: 20px 0 0;
  max-width: 780px;
  color: rgba(15, 23, 42, 0.72);
  font-size: 17px;
  line-height: 1.7;
}

.osp-public-card-grid {
  margin-top: 30px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.osp-public-card {
  border: 1px solid rgba(6, 78, 59, 0.1);
  background: rgba(255, 255, 255, 0.82);
  border-radius: 26px;
  padding: 24px;
  box-shadow: 0 10px 28px rgba(6, 78, 59, 0.05);
}

.osp-public-card-eyebrow {
  margin: 0 0 12px;
  color: #b45309;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.osp-public-card-title {
  margin: 0;
  color: #064e3b;
  font-size: 21px;
  line-height: 1.1;
  letter-spacing: -0.04em;
  font-weight: 950;
}

.osp-public-card-body {
  margin: 14px 0 0;
  color: rgba(15, 23, 42, 0.66);
  font-size: 14px;
  line-height: 1.7;
}

.osp-public-card-link {
  display: inline-flex;
  margin-top: 18px;
  color: #065f46;
  text-decoration: none;
  font-size: 14px;
  font-weight: 950;
}

.osp-public-trust-strip {
  border-top: 1px solid rgba(6, 78, 59, 0.1);
  border-bottom: 1px solid rgba(6, 78, 59, 0.1);
  background: rgba(255, 255, 255, 0.62);
}

.osp-public-trust-inner {
  width: min(100%, 1180px);
  margin: 0 auto;
  padding: 18px 20px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.osp-public-trust-inner p {
  margin: 0;
  color: rgba(15, 23, 42, 0.72);
  font-size: 14px;
  font-weight: 900;
}

.osp-public-feature-band {
  width: min(100%, 1180px);
  margin: 0 auto;
  padding: 36px 20px;
}

.osp-public-feature-panel {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 24px;
  border-radius: 34px;
  background: #064e3b;
  color: #fff7ed;
  padding: 34px;
  box-shadow: 0 24px 70px rgba(6, 78, 59, 0.14);
}

.osp-public-feature-panel h2 {
  margin: 14px 0 0;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1;
  letter-spacing: -0.055em;
}

.osp-public-feature-panel p {
  color: rgba(254, 243, 199, 0.86);
}

.osp-public-feature-actions {
  display: grid;
  align-content: end;
  gap: 12px;
}

.osp-public-footer {
  margin-top: 48px;
  border-top: 1px solid rgba(6, 78, 59, 0.1);
  background: #064e3b;
  color: #fef3c7;
  padding: 44px 20px;
}

.osp-public-footer-inner {
  width: min(100%, 1180px);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 36px;
}

.osp-public-footer-title {
  margin: 0;
  font-size: 14px;
  font-weight: 950;
  letter-spacing: 0.2em;
}

.osp-public-footer-body {
  margin: 14px 0 0;
  max-width: 460px;
  color: rgba(254, 243, 199, 0.82);
  font-size: 14px;
  line-height: 1.7;
}

.osp-public-footer-links {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.osp-public-footer-links a {
  color: rgba(254, 243, 199, 0.82);
  text-decoration: none;
  font-size: 14px;
  font-weight: 750;
}

/* OSP forms */
.osp-form-card {
  border: 1px solid rgba(6, 78, 59, 0.1);
  background: rgba(255, 255, 255, 0.86);
  border-radius: 32px;
  padding: 26px;
  box-shadow: 0 18px 50px rgba(6, 78, 59, 0.08);
}

.osp-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.osp-form-field {
  display: block;
}

.osp-form-field-full {
  grid-column: 1 / -1;
}

.osp-form-label {
  display: block;
  margin-bottom: 8px;
  color: #064e3b;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.osp-form-input,
.osp-form-select,
.osp-form-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid rgba(6, 78, 59, 0.16);
  background: #ffffff;
  color: #0f172a;
  border-radius: 18px;
  padding: 13px 15px;
  font: inherit;
  font-size: 14px;
  outline: none;
}

.osp-form-textarea {
  min-height: 128px;
  resize: vertical;
}

.osp-form-input:focus,
.osp-form-select:focus,
.osp-form-textarea:focus {
  border-color: #047857;
  box-shadow: 0 0 0 4px rgba(4, 120, 87, 0.12);
}

.osp-form-note {
  margin-top: 18px;
  border-radius: 20px;
  background: #fffbeb;
  color: rgba(15, 23, 42, 0.76);
  padding: 15px;
  font-size: 14px;
  line-height: 1.6;
}

.osp-form-alert {
  margin-top: 16px;
  border-radius: 20px;
  padding: 15px;
  font-size: 14px;
  font-weight: 750;
  line-height: 1.6;
}

.osp-form-alert-success {
  border: 1px solid rgba(6, 95, 70, 0.16);
  background: #ecfdf5;
  color: #064e3b;
}

.osp-form-alert-error {
  border: 1px solid rgba(153, 27, 27, 0.16);
  background: #fef2f2;
  color: #7f1d1d;
}

.osp-form-alert-pending {
  border: 1px solid rgba(180, 83, 9, 0.16);
  background: #fffbeb;
  color: #92400e;
}

.osp-form-submit {
  margin-top: 18px;
  border: 0;
  border-radius: 999px;
  background: #064e3b;
  color: #fef3c7;
  padding: 15px 24px;
  font-size: 13px;
  font-weight: 950;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  box-shadow: 0 12px 28px rgba(6, 78, 59, 0.18);
}

.osp-form-submit:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

@media (max-width: 980px) {
  .osp-public-nav {
    display: none;
  }

  .osp-public-mobile-nav {
    display: flex;
  }

  .osp-public-hero-inner,
  .osp-public-feature-panel,
  .osp-public-footer-inner {
    grid-template-columns: 1fr;
  }

  .osp-public-card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .osp-public-trust-inner {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .osp-public-header-inner {
    align-items: flex-start;
  }

  .osp-public-brand-subtitle,
  .osp-public-header-actions .osp-public-button-secondary {
    display: none;
  }

  .osp-public-hero-inner {
    padding: 52px 18px;
  }

  .osp-public-title {
    font-size: 44px;
  }

  .osp-public-card-grid,
  .osp-form-grid,
  .osp-public-quick-grid,
  .osp-public-trust-inner,
  .osp-public-footer-links {
    grid-template-columns: 1fr;
  }

  .osp-public-feature-panel {
    padding: 24px;
  }

  .osp-public-section {
    padding: 44px 18px;
  }
}

/* ============================================================
   OSP OTA PARTNER PAGE PRODUCTION LAYOUT
   ============================================================ */

.osp-ota-intro-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(340px, 0.72fr);
  gap: 24px;
  align-items: stretch;
}

.osp-ota-checklist-card {
  border: 1px solid rgba(6, 78, 59, 0.12);
  background: rgba(255, 255, 255, 0.84);
  border-radius: 28px;
  padding: 26px;
  box-shadow: 0 18px 50px rgba(6, 78, 59, 0.07);
}

.osp-ota-checklist-card h3 {
  margin: 0;
  color: #064e3b;
  font-size: 26px;
  line-height: 1.05;
  letter-spacing: -0.045em;
  font-weight: 950;
}

.osp-ota-checklist-card p {
  margin: 12px 0 0;
  color: rgba(15, 23, 42, 0.68);
  line-height: 1.65;
}

.osp-ota-steps {
  margin: 20px 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 12px;
}

.osp-ota-steps li {
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 12px;
  align-items: start;
  color: rgba(15, 23, 42, 0.72);
  font-size: 14px;
  line-height: 1.55;
}

.osp-ota-step-number {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: #064e3b;
  color: #fef3c7;
  font-size: 12px;
  font-weight: 950;
}

.osp-ota-form-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.38fr);
  gap: 24px;
  align-items: start;
}

.osp-ota-sidebar {
  position: sticky;
  top: 118px;
  border: 1px solid rgba(6, 78, 59, 0.12);
  background: #064e3b;
  color: #fff7ed;
  border-radius: 28px;
  padding: 24px;
  box-shadow: 0 18px 50px rgba(6, 78, 59, 0.1);
}

.osp-ota-sidebar h3 {
  margin: 0;
  font-size: 25px;
  line-height: 1.05;
  letter-spacing: -0.045em;
  font-weight: 950;
}

.osp-ota-sidebar p {
  color: rgba(254, 243, 199, 0.84);
  line-height: 1.6;
  font-size: 14px;
}

.osp-ota-sidebar-list {
  margin: 18px 0 0;
  padding-left: 18px;
  color: rgba(254, 243, 199, 0.9);
  font-size: 14px;
  line-height: 1.7;
}

.osp-ota-status-pill {
  display: inline-flex;
  margin-bottom: 14px;
  border-radius: 999px;
  background: rgba(254, 243, 199, 0.14);
  color: #fde68a;
  padding: 8px 12px;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.osp-ota-form-card-title {
  margin: 0 0 18px;
  color: #064e3b;
  font-size: 24px;
  font-weight: 950;
  letter-spacing: -0.04em;
}

@media (max-width: 980px) {
  .osp-ota-intro-grid,
  .osp-ota-form-layout {
    grid-template-columns: 1fr;
  }

  .osp-ota-sidebar {
    position: static;
  }
}

/* ============================================================
   OSP DEVELOPERS / API OVERVIEW PAGE
   ============================================================ */

.osp-dev-overview-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.48fr);
  gap: 24px;
  align-items: start;
}

.osp-dev-api-panel {
  border: 1px solid rgba(6, 78, 59, 0.12);
  background: rgba(255, 255, 255, 0.84);
  border-radius: 28px;
  padding: 26px;
  box-shadow: 0 18px 50px rgba(6, 78, 59, 0.07);
}

.osp-dev-api-panel h3 {
  margin: 0;
  color: #064e3b;
  font-size: 27px;
  line-height: 1.05;
  letter-spacing: -0.045em;
  font-weight: 950;
}

.osp-dev-api-panel p {
  margin: 12px 0 0;
  color: rgba(15, 23, 42, 0.68);
  line-height: 1.65;
}

.osp-dev-flow-list {
  margin: 22px 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 14px;
}

.osp-dev-flow-list li {
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 14px;
  align-items: start;
}

.osp-dev-flow-number {
  width: 38px;
  height: 38px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: #064e3b;
  color: #fef3c7;
  font-size: 12px;
  font-weight: 950;
}

.osp-dev-flow-title {
  display: block;
  color: #064e3b;
  font-size: 15px;
  font-weight: 950;
}

.osp-dev-flow-body {
  display: block;
  margin-top: 4px;
  color: rgba(15, 23, 42, 0.68);
  font-size: 14px;
  line-height: 1.55;
}

.osp-dev-boundary-card {
  position: sticky;
  top: 118px;
  border: 1px solid rgba(6, 78, 59, 0.12);
  background: #064e3b;
  color: #fff7ed;
  border-radius: 28px;
  padding: 24px;
  box-shadow: 0 18px 50px rgba(6, 78, 59, 0.1);
}

.osp-dev-boundary-card h3 {
  margin: 0;
  font-size: 26px;
  line-height: 1.05;
  letter-spacing: -0.045em;
  font-weight: 950;
}

.osp-dev-boundary-card p {
  color: rgba(254, 243, 199, 0.84);
  line-height: 1.6;
  font-size: 14px;
}

.osp-dev-boundary-list {
  margin: 18px 0 0;
  padding-left: 18px;
  color: rgba(254, 243, 199, 0.9);
  font-size: 14px;
  line-height: 1.7;
}

.osp-dev-endpoint-table {
  border: 1px solid rgba(6, 78, 59, 0.12);
  background: rgba(255, 255, 255, 0.84);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 18px 50px rgba(6, 78, 59, 0.07);
}

.osp-dev-endpoint-row {
  display: grid;
  grid-template-columns: 160px 1fr 210px;
  gap: 18px;
  padding: 18px 20px;
  border-top: 1px solid rgba(6, 78, 59, 0.1);
  align-items: start;
}

.osp-dev-endpoint-row:first-child {
  border-top: 0;
}

.osp-dev-method {
  display: inline-flex;
  width: fit-content;
  border-radius: 999px;
  background: #064e3b;
  color: #fef3c7;
  padding: 7px 10px;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.1em;
}

.osp-dev-path {
  color: #064e3b;
  font-size: 14px;
  font-weight: 950;
  word-break: break-word;
}

.osp-dev-description {
  color: rgba(15, 23, 42, 0.68);
  font-size: 14px;
  line-height: 1.55;
}

.osp-dev-status {
  display: inline-flex;
  width: fit-content;
  border-radius: 999px;
  background: #fffbeb;
  color: #92400e;
  padding: 7px 10px;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

@media (max-width: 980px) {
  .osp-dev-overview-grid,
  .osp-dev-endpoint-row {
    grid-template-columns: 1fr;
  }

  .osp-dev-boundary-card {
    position: static;
  }
}

/* ============================================================
   OSP ADMIN PARTNER REVIEW SURFACE
   Temporary internal admin surface for development QA.
   ============================================================ */

.osp-admin-root {
  min-height: 100vh;
