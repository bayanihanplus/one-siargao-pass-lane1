          </Link>
          <nav className="hidden items-center gap-5 text-xs font-bold uppercase tracking-[0.18em] text-slate-700 md:flex">
            <Link href="/travelers">Travelers</Link>
            <Link href="/passport-trails">Passport Trails</Link>
            <Link href="/operators">Operators</Link>
            <Link href="/ota">OTA / API</Link>
