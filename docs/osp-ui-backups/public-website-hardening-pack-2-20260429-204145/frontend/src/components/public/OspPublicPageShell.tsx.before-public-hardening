  return (
    <main className="min-h-screen bg-[#f6f1e8] text-slate-950">
      <header className="border-b border-amber-900/10 bg-[#fffaf0]/90">
        <div className="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-4">
          <Link href="/" className="text-sm font-black tracking-[0.22em] text-emerald-950">
