export function PublicButton(props: PublicCta) {
  const variant = props.variant || "primary";
  const className =
    variant === "primary"
      ? "rounded-full bg-emerald-950 px-5 py-3 text-sm font-black text-amber-100 shadow-sm"
      : "rounded-full border border-emerald-950/20 bg-white/70 px-5 py-3 text-sm font-black text-emerald-950 shadow-sm";

  return (
    <Link href={props.href} className={className}>
      {props.label}
    </Link>
  );
}

export function PublicSection(props: {
  eyebrow?: string;
  title: string;
  body?: string;
  children?: ReactNode;
}) {
  return (
    <section className="mx-auto w-full max-w-6xl px-5 py-10">
      {props.eyebrow ? (
        <p className="mb-3 text-xs font-black uppercase tracking-[0.24em] text-emerald-800">
          {props.eyebrow}
        </p>
      ) : null}
      <h2 className="max-w-3xl text-3xl font-black tracking-[-0.05em] text-emerald-950 md:text-4xl">
        {props.title}
      </h2>
      {props.body ? (
        <p className="mt-4 max-w-3xl text-base leading-7 text-slate-700">
          {props.body}
        </p>
      ) : null}
      {props.children ? <div className="mt-6">{props.children}</div> : null}
    </section>
  );
}

export function PublicCardGrid(props: { cards: PublicCard[] }) {
  return (
    <div className="grid gap-4 md:grid-cols-3">
      {props.cards.map((card) => (
        <article key={card.title} className="rounded-[1.5rem] border border-amber-900/10 bg-white/75 p-5 shadow-sm">
          {card.eyebrow ? (
            <p className="mb-2 text-[10px] font-black uppercase tracking-[0.22em] text-amber-800">
              {card.eyebrow}
            </p>
          ) : null}
          <h3 className="text-lg font-black tracking-[-0.03em] text-emerald-950">{card.title}</h3>
          <p className="mt-3 text-sm leading-6 text-slate-650">{card.body}</p>
          {card.href ? (
            <Link href={card.href} className="mt-4 inline-flex text-sm font-black text-emerald-900">
              Learn more →
            </Link>
          ) : null}
        </article>
      ))}
    </div>
  );
}
