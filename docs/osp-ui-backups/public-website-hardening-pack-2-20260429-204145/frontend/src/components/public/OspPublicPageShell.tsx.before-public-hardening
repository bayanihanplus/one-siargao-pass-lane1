            <Link href="/support">Support</Link>
          </nav>
          <Link
            href="/traveler/start"
            className="rounded-full bg-emerald-950 px-4 py-2 text-xs font-black uppercase tracking-[0.16em] text-amber-100 shadow-sm"
          >
            Create Pass
          </Link>
        </div>
      </header>

      <section className="mx-auto w-full max-w-6xl px-5 py-14 md:py-20">
        {props.eyebrow ? (
          <p className="mb-4 text-xs font-black uppercase tracking-[0.28em] text-emerald-800">
            {props.eyebrow}
          </p>
        ) : null}

        <div className="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
          <div>
            <h1 className="max-w-4xl text-4xl font-black leading-[0.95] tracking-[-0.06em] text-emerald-950 md:text-6xl">
              {props.title}
            </h1>
            <p className="mt-6 max-w-2xl text-base leading-7 text-slate-700 md:text-lg">
              {props.subtitle}
            </p>
          </div>

          <div className="rounded-[2rem] border border-amber-900/10 bg-white/70 p-5 shadow-sm">
            <p className="text-xs font-black uppercase tracking-[0.22em] text-amber-800">
              Platform Line
            </p>
            <p className="mt-3 text-2xl font-black tracking-[-0.04em] text-emerald-950">
              Powering the Digital Island.
            </p>
            <p className="mt-3 text-sm leading-6 text-slate-600">
              One governed platform for traveler access, QR identity, verified island experiences, partner distribution, and compliance-ready tourism operations.
            </p>
          </div>
        </div>

        {(props.primaryCta || props.secondaryCta) ? (
          <div className="mt-8 flex flex-wrap gap-3">
            {props.primaryCta ? <PublicButton {...props.primaryCta} variant="primary" /> : null}
            {props.secondaryCta ? <PublicButton {...props.secondaryCta} variant="secondary" /> : null}
