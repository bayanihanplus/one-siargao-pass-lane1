  label: string;
  href: string;
  variant?: "primary" | "secondary";
};

type PublicCard = {
  title: string;
  body: string;
  href?: string;
  eyebrow?: string;
};

type OspPublicPageShellProps = {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta?: PublicCta;
  secondaryCta?: PublicCta;
  children?: ReactNode;
};

