.osp-public-subtitle,
.osp-public-hero p,
.osp-public-hero-copy p,
.osp-public-video-copy p:not(.osp-public-eyebrow),
.osp-public-section-body,
.osp-public-section-lead,
.osp-public-card-body,
.osp-public-card p,
.osp-public-static-copy p:not(.osp-public-eyebrow),
.osp-public-media-banner p:not(.osp-public-eyebrow),
