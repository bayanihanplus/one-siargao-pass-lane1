/* ============================================================
   OSP PUBLIC-04 — SOFT OFFICIAL OSP BLUE-GREEN PANTONE SYSTEM
   Board-aligned subtle hue system based on approved OSP logo.
   ============================================================ */

:root {
  --osp-blue-deep: #0c3d66;
  --osp-blue-ink: #16324a;
  --osp-blue: #2c6fa3;
  --osp-blue-bright: #4f8fbe;
  --osp-sky: #82bfd5;
  --osp-cyan: #17a9b8;
  --osp-teal-soft: #cfeeed;
  --osp-seafoam: #ddf4f1;
  --osp-blue-soft: #eaf3fb;
  --osp-blue-surface: #f3f8fb;
  --osp-blue-border: rgba(44, 111, 163, 0.14);
  --osp-ink: #16324a;
  --osp-muted: rgba(22, 50, 74, 0.72);
  --osp-sand: #f2c14e;
  --osp-cream: #fbfaf6;
  --osp-white: #f8fbfd;
}

/* Global public background */
.osp-public-root {
  background:
    radial-gradient(circle at 10% 8%, rgba(130, 191, 213, 0.18), transparent 28%),
    radial-gradient(circle at 88% 10%, rgba(23, 169, 184, 0.10), transparent 26%),
    linear-gradient(180deg, #f7fbfd 0%, #eef5fa 50%, #f8fbfd 100%) !important;
  color: var(--osp-ink) !important;
}

/* Header and brand */
.osp-public-header {
  border-bottom: 1px solid rgba(44, 111, 163, 0.10) !important;
  background: rgba(248, 251, 253, 0.92) !important;
  backdrop-filter: blur(12px);
}

.osp-public-brand {
  color: var(--osp-blue-deep) !important;
}

.osp-public-brand-logo-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid rgba(44, 111, 163, 0.10);
  box-shadow: 0 10px 24px rgba(44, 111, 163, 0.08);
  overflow: hidden;
  flex: 0 0 auto;
}

.osp-public-brand-logo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 5px;
}

.osp-public-brand-title,
.osp-public-footer-title {
  color: var(--osp-blue-deep) !important;
}

.osp-public-brand-subtitle,
.osp-public-footer-body {
  color: rgba(22, 50, 74, 0.66) !important;
}

/* Navigation */
.osp-public-nav a,
.osp-public-mobile-nav a,
.osp-public-footer-links a {
  color: rgba(22, 50, 74, 0.74) !important;
}

.osp-public-nav a:hover,
.osp-public-mobile-nav a:hover,
.osp-public-footer-links a:hover {
  color: var(--osp-blue) !important;
}

/* Text hierarchy */
.osp-public-eyebrow,
.osp-public-card-eyebrow,
.osp-public-info-label {
  color: var(--osp-blue) !important;
  letter-spacing: 0.16em;
}

.osp-public-title,
.osp-public-hero h1,
.osp-public-hero-copy h1,
.osp-public-video-copy h1,
.osp-public-section-title,
.osp-public-section h2,
.osp-public-static-copy h2,
.osp-public-media-banner h2,
.osp-public-card-title,
.osp-public-card h3,
.osp-public-info-title,
.osp-government-boundary-grid h3 {
