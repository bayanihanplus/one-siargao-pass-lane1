  text-decoration: none !important;
  border: 1px solid transparent;
  transition:
    color 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s ease;
}

.osp-public-nav a:hover,
.osp-public-nav-link:hover {
  color: #0c3d66 !important;
  background: rgba(255, 255, 255, 0.72) !important;
  border-color: rgba(44, 111, 163, 0.12) !important;
  box-shadow: 0 10px 22px rgba(44, 111, 163, 0.07);
  transform: translateY(-1px);
}

.osp-public-nav a.active,
.osp-public-nav-link-active {
  color: #1c4f80 !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.92), rgba(234,243,251,0.86)) !important;
  border-color: rgba(44, 111, 163, 0.17) !important;
  box-shadow:
    0 10px 22px rgba(44, 111, 163, 0.08),
    inset 0 1px 0 rgba(255,255,255,0.88);
}

.osp-public-nav a.active::after,
.osp-public-nav-link-active::after {
  content: "";
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 6px;
  height: 3px;
  border-radius: 999px;
  background: linear-gradient(90deg, #f2c14e, #17a9b8);
}

/* Header CTA area */
.osp-public-header-actions {
  display: flex;
  align-items: center;
  gap: 12px !important;
  flex: 0 0 auto;
}

.osp-public-header-actions a,
.osp-public-header-actions .osp-public-button,
.osp-public-header-actions .osp-public-primary-button,
.osp-public-header-actions .osp-public-secondary-button {
  min-height: 52px !important;
  padding: 0 25px !important;
  border-radius: 999px !important;
  font-size: 14px !important;
  line-height: 1.02 !important;
  font-weight: 950 !important;
  letter-spacing: -0.015em !important;
  text-decoration: none !important;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease;
}

.osp-public-header-actions a:first-child,
.osp-public-header-actions .osp-public-secondary-button:first-child {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,251,253,0.90)) !important;
  color: #0c3d66 !important;
  border: 1px solid rgba(44, 111, 163, 0.18) !important;
  box-shadow:
    0 10px 22px rgba(44, 111, 163, 0.065),
    inset 0 1px 0 rgba(255,255,255,0.88) !important;
}

.osp-public-header-actions a:first-child:hover,
.osp-public-header-actions .osp-public-secondary-button:first-child:hover {
  transform: translateY(-2px);
  border-color: rgba(44, 111, 163, 0.28) !important;
  box-shadow:
    0 16px 30px rgba(44, 111, 163, 0.105),
    inset 0 1px 0 rgba(255,255,255,0.92) !important;
}

.osp-public-header-actions a:last-child,
.osp-public-header-actions .osp-public-primary-button:last-child {
  background:
    linear-gradient(135deg, #164f7c 0%, #217f9a 100%) !important;
  color: #ffffff !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
  box-shadow:
    0 14px 28px rgba(44, 111, 163, 0.18),
    inset 0 1px 0 rgba(255,255,255,0.18) !important;
}

.osp-public-header-actions a:last-child:hover,
.osp-public-header-actions .osp-public-primary-button:last-child:hover {
  transform: translateY(-2px);
  background:
    linear-gradient(135deg, #0c3d66 0%, #17a9b8 100%) !important;
  box-shadow:
    0 18px 34px rgba(44, 111, 163, 0.22),
    inset 0 1px 0 rgba(255,255,255,0.22) !important;
}

/* Better visible focus for keyboard users */
.osp-public-nav a:focus-visible,
.osp-public-nav-link:focus-visible,
.osp-public-header-actions a:focus-visible {
  outline: 3px solid rgba(23, 169, 184, 0.34) !important;
  outline-offset: 4px !important;
}

/* Prevent squeezed nav on medium screens */
@media (max-width: 1180px) {
  .osp-public-brand {
    min-width: 210px;
  }

  .osp-public-nav a,
  .osp-public-nav-link {
    padding: 0 9px !important;
    font-size: 12px !important;
    letter-spacing: 0.085em !important;
  }

  .osp-public-header-actions a,
  .osp-public-header-actions .osp-public-button,
  .osp-public-header-actions .osp-public-primary-button,
  .osp-public-header-actions .osp-public-secondary-button {
    padding: 0 18px !important;
    min-height: 48px !important;
  }
}

@media (max-width: 980px) {
  .osp-public-header {
    min-height: 78px;
  }

  .osp-public-header-inner {
    min-height: 78px;
  }

  .osp-public-brand {
    min-width: auto;
  }

  .osp-public-nav {
    display: none !important;
  }

  .osp-public-header-actions {
    gap: 8px !important;
  }
}

@media (max-width: 640px) {
  .osp-public-brand-title {
    font-size: 12px !important;
    letter-spacing: 0.16em !important;
  }

  .osp-public-brand-subtitle {
    font-size: 11px !important;
  }

  .osp-public-brand-logo-wrap {
    width: 44px !important;
    height: 44px !important;
  }

  .osp-public-header-actions a,
  .osp-public-header-actions .osp-public-button,
  .osp-public-header-actions .osp-public-primary-button,
  .osp-public-header-actions .osp-public-secondary-button {
    min-height: 44px !important;
    padding: 0 14px !important;
    font-size: 12px !important;
  }
}

/* ============================================================
   PUBLIC-06 — HOMEPAGE MASTER GATEWAY HARDENING
   ============================================================ */

.osp-home-routing-section {
  padding-top: clamp(56px, 7vw, 96px) !important;
}

.osp-home-pathway-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(18px, 2vw, 26px);
  margin-top: clamp(28px, 4vw, 46px);
}

.osp-home-pathway-card {
  min-height: 220px;
  border-radius: 30px;
  padding: clamp(22px, 2.6vw, 30px);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(248, 251, 253, 0.88));
  border: 1px solid rgba(44, 111, 163, 0.11);
  box-shadow: 0 18px 40px rgba(44, 111, 163, 0.065);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.osp-home-pathway-card:hover {
  transform: translateY(-4px);
  border-color: rgba(44, 111, 163, 0.22);
  box-shadow: 0 26px 56px rgba(44, 111, 163, 0.11);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(234, 243, 251, 0.92));
}

.osp-home-pathway-card span {
  color: #2c6fa3;
  font-size: 12px;
  font-weight: 950;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.osp-home-pathway-card strong {
  display: block;
  color: #0c3d66;
  font-size: clamp(24px, 2.2vw, 34px);
  line-height: 1;
  letter-spacing: -0.055em;
  font-weight: 900;
  margin-top: 18px;
}

.osp-home-pathway-card p {
  color: rgba(22, 50, 74, 0.70);
  font-size: 15px;
  line-height: 1.55;
  letter-spacing: -0.01em;
  margin: 18px 0 0;
}

.osp-home-authority-band {
  width: min(1240px, calc(100vw - 40px));
  margin-inline: auto;
  border-radius: 34px;
  padding: clamp(28px, 4vw, 44px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: clamp(24px, 4vw, 44px);
  background:
    radial-gradient(circle at 18% 18%, rgba(242, 193, 78, 0.16), transparent 28%),
    linear-gradient(135deg, rgba(12, 61, 102, 0.95), rgba(23, 169, 184, 0.76));
  box-shadow: 0 22px 52px rgba(44, 111, 163, 0.13);
  border: 1px solid rgba(255, 255, 255, 0.24);
}

.osp-home-authority-band h2 {
  color: #ffffff !important;
  font-size: clamp(30px, 3.6vw, 56px);
  line-height: 1.02;
  letter-spacing: -0.06em;
  margin: 0;
  max-width: 820px;
}

.osp-home-authority-band p:not(.osp-public-eyebrow) {
  color: rgba(255, 255, 255, 0.82) !important;
  font-size: 16px;
  line-height: 1.65;
  max-width: 780px;
  margin-top: 18px;
}

.osp-home-authority-band .osp-public-eyebrow {
  color: rgba(242, 193, 78, 0.96) !important;
}

.osp-home-authority-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.osp-home-authority-actions .osp-public-button,
.osp-home-authority-actions a {
  min-height: 52px;
  border-radius: 999px;
  white-space: nowrap;
}

.osp-home-authority-actions .osp-public-button:first-child,
.osp-home-authority-actions a:first-child {
  background: rgba(242, 193, 78, 0.96) !important;
  color: #0c3d66 !important;
  border-color: transparent !important;
}

.osp-home-authority-actions .osp-public-button:last-child,
.osp-home-authority-actions a:last-child {
  background: rgba(255, 255, 255, 0.92) !important;
  color: #0c3d66 !important;
  border-color: rgba(255, 255, 255, 0.28) !important;
}

/* Homepage hero typography softening */
.osp-public-hero-copy h1,
.osp-public-video-copy h1 {
  letter-spacing: -0.068em !important;
  line-height: 0.98 !important;
  max-width: 790px;
}

.osp-public-hero-copy p,
.osp-public-video-copy p:not(.osp-public-eyebrow) {
  max-width: 720px;
  line-height: 1.62 !important;
}

/* Homepage media panels: reduce visual heaviness */
.osp-public-video-frame,
.osp-public-static-art {
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.18);
}

@media (max-width: 980px) {
  .osp-home-pathway-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .osp-home-authority-band {
    grid-template-columns: 1fr;
  }

  .osp-home-authority-actions {
    justify-content: flex-start;
  }
}

@media (max-width: 640px) {
  .osp-home-pathway-grid {
    grid-template-columns: 1fr;
  }

  .osp-home-pathway-card {
    min-height: 190px;
  }

  .osp-home-authority-band {
    width: min(100% - 28px, 1240px);
    border-radius: 28px;
  }

  .osp-home-authority-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .osp-home-authority-actions .osp-public-button,
  .osp-home-authority-actions a {
    width: 100%;
  }
}
