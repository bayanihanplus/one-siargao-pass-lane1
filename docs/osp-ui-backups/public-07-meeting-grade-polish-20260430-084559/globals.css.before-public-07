.osp-public-media-orbit span {
  position: absolute;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.28);
}

.osp-public-media-orbit span:nth-child(1) {
  inset: 16px;
}

.osp-public-media-orbit span:nth-child(2) {
  inset: 42px;
}

.osp-public-media-orbit span:nth-child(3) {
