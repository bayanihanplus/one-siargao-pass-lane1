/* ============================================================
   OSP PUBLIC-02 — STATIC PAGE BANNER SYSTEM
   ============================================================ */

.osp-public-static-banner {
  width: min(1240px, calc(100vw - 40px));
  margin: clamp(26px, 4vw, 52px) auto;
  border-radius: 36px;
  padding: clamp(24px, 4vw, 42px);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(330px, 0.72fr);
  gap: clamp(22px, 3.6vw, 42px);
  align-items: center;
  border: 1px solid rgba(6, 78, 59, 0.1);
  background:
    radial-gradient(circle at 10% 15%, rgba(253, 230, 138, 0.28), transparent 28%),
    radial-gradient(circle at 96% 16%, rgba(20, 184, 166, 0.18), transparent 30%),
    rgba(255, 255, 255, 0.88);
  box-shadow: 0 24px 76px rgba(6, 78, 59, 0.09);
  overflow: hidden;
  position: relative;
}

.osp-public-static-copy {
  position: relative;
  z-index: 2;
}

.osp-public-static-copy h2 {
  margin: 0;
  max-width: 780px;
  color: #064e3b;
  font-size: clamp(30px, 3vw, 48px);
  line-height: 1.05;
  letter-spacing: -0.048em;
  font-weight: 850;
  text-wrap: balance;
}

.osp-public-static-copy p:not(.osp-public-eyebrow) {
  max-width: 820px;
  color: rgba(15, 23, 42, 0.68);
  font-size: 16px;
  line-height: 1.66;
  letter-spacing: -0.012em;
}

.osp-public-static-art {
  min-height: 260px;
  border-radius: 30px;
  background: linear-gradient(135deg, rgba(6, 78, 59, 0.96), rgba(15, 118, 110, 0.92));
