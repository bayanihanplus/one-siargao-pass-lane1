  gap: 10px;
  margin-top: 42px;
}

.osp-public-static-points div {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  padding: 11px 13px;
}

.osp-public-static-points div span {
  width: 9px;
  height: 9px;
  border-radius: 999px;
  background: #fde68a;
  flex: 0 0 auto;
}

.osp-public-static-points strong {
  font-size: 13px;
  line-height: 1.18;
  font-weight: 850;
}

.osp-public-static-home .osp-public-static-art {
  background: linear-gradient(135deg, #064e3b, #0f766e 55%, #0e7490);
}

.osp-public-static-traveler .osp-public-static-art {
  background: linear-gradient(135deg, #064e3b, #0f766e);
}

.osp-public-static-trails .osp-public-static-art {
  background: linear-gradient(135deg, #075985, #047857);
}

.osp-public-static-operator .osp-public-static-art {
  background: linear-gradient(135deg, #064e3b, #365314);
}

.osp-public-static-partner .osp-public-static-art {
  background: linear-gradient(135deg, #0f766e, #1e3a8a);
}

.osp-public-static-government .osp-public-static-art {
  background: linear-gradient(135deg, #064e3b, #92400e);
}

.osp-public-static-support .osp-public-static-art {
  background: linear-gradient(135deg, #064e3b, #334155);
}

@media (max-width: 980px) {
  .osp-public-static-banner {
    grid-template-columns: 1fr;
  }

