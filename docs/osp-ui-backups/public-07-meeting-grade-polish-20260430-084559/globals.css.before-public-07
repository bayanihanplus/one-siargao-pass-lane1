  position: absolute;
  inset: -40%;
  background:
    radial-gradient(circle at 25% 35%, rgba(253, 230, 138, 0.34), transparent 24%),
    radial-gradient(circle at 70% 18%, rgba(255, 255, 255, 0.16), transparent 22%);
  transform: rotate(12deg);
}

.osp-public-static-skyline {
  position: absolute;
  inset: auto 0 0;
  height: 42%;
  opacity: 0.5;
}

.osp-public-static-skyline span {
  position: absolute;
  bottom: 0;
  border-radius: 999px 999px 0 0;
  background: rgba(255, 247, 237, 0.12);
}

.osp-public-static-skyline span:nth-child(1) {
  left: -8%;
  width: 48%;
  height: 72%;
}

.osp-public-static-skyline span:nth-child(2) {
  left: 28%;
  width: 44%;
  height: 92%;
}

.osp-public-static-skyline span:nth-child(3) {
  right: -8%;
  width: 46%;
  height: 62%;
}

.osp-public-static-badge {
  position: relative;
  z-index: 2;
  display: inline-flex;
  border-radius: 999px;
  background: #fde68a;
  color: #064e3b;
  padding: 9px 13px;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.12em;
