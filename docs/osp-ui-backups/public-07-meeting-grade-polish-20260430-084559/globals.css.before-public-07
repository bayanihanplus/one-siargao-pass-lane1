}

/* Buttons */
.osp-public-button-primary,
.osp-public-primary-button {
  background: linear-gradient(135deg, #1c4f80, #2b7096) !important;
  color: #ffffff !important;
  border: 1px solid rgba(28, 79, 128, 0.08) !important;
