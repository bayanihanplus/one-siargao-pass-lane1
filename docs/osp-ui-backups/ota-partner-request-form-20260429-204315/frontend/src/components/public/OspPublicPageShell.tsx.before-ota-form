export function PublicButton(props: PublicCta) {
  const variant = props.variant || "primary";

  const className =
    variant === "primary"
      ? "rounded-full bg-emerald-950 px-6 py-3 text-sm font-black text-amber-100 shadow-sm"
      : variant === "light"
        ? "rounded-full bg-amber-100 px-6 py-3 text-sm font-black text-emerald-950 shadow-sm"
        : "rounded-full border border-emerald-950/20 bg-white/80 px-6 py-3 text-sm font-black text-emerald-950 shadow-sm";

  return (
    <Link href={props.href} className={className}>
      {props.label}
    </Link>
  );
}

