"use client";

import { FormEvent, useMemo, useState } from "react";

type SubmitState =
  | { status: "idle"; message: "" }
  | { status: "submitting"; message: "Submitting partner request..." }
  | { status: "success"; message: string; applicationId?: string }
  | { status: "error"; message: string };

const partnerTypes = [
  { value: "OTA", label: "OTA / Online Travel Agency" },
  { value: "INTERNATIONAL_OTA", label: "International OTA" },
  { value: "TRAVEL_AGENCY", label: "Travel Agency" },
  { value: "HOTEL_DESK", label: "Hotel / Front Desk" },
  { value: "OPERATOR", label: "Local Operator" },
  { value: "AFFILIATE", label: "Affiliate / Distribution Partner" },
];

function getApiBaseUrl() {
  const explicit = process.env.NEXT_PUBLIC_API_BASE_URL;
  if (explicit) return explicit.replace(/\/$/, "");
  return "http://localhost:8001/api/v1";
}

export default function OtaPartnerRequestForm() {
  const apiBaseUrl = useMemo(() => getApiBaseUrl(), []);
  const [state, setState] = useState<SubmitState>({ status: "idle", message: "" });

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const form = event.currentTarget;
    const formData = new FormData(form);

    const payload = {
      partnerName: String(formData.get("partnerName") || "").trim(),
      partnerType: String(formData.get("partnerType") || "TRAVEL_AGENCY").trim(),
      contactEmail: String(formData.get("contactEmail") || "").trim(),
      contactMobile: String(formData.get("contactMobile") || "").trim(),
      companyName: String(formData.get("companyName") || "").trim(),
      websiteUrl: String(formData.get("websiteUrl") || "").trim(),
      countryCode: String(formData.get("countryCode") || "").trim(),
      notes: String(formData.get("notes") || "").trim(),
    };

    if (!payload.partnerName || !payload.contactEmail) {
      setState({
        status: "error",
        message: "Please provide your organization name and contact email.",
      });
      return;
    }

    setState({ status: "submitting", message: "Submitting partner request..." });

    try {
      const response = await fetch(`${apiBaseUrl}/partners/apply`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await response.json().catch(() => null);

      if (!response.ok || !data?.ok) {
        setState({
          status: "error",
          message:
            data?.message ||
            data?.error?.message ||
            "Partner request could not be submitted. Please check the details and try again.",
        });
        return;
      }

      form.reset();

      setState({
        status: "success",
        message:
          data?.data?.message ||
          "Partner request received. The OSP team will review the request before any API or partner access is activated.",
        applicationId: data?.data?.id,
      });
    } catch {
      setState({
        status: "error",
        message: "Unable to reach the OSP API. Please make sure the backend is running and try again.",
      });
    }
  }

  return (
    <form onSubmit={handleSubmit} className="osp-form-card">\n      <h3 className="osp-ota-form-card-title">Partner request details</h3>
      <div className="osp-form-grid">
        <label className="osp-form-field">
          <span className="osp-form-label">Organization / Partner Name</span>
          <input name="partnerName" required placeholder="Example: Siargao Travel Desk" className="osp-form-input" />
        </label>

        <label className="osp-form-field">
          <span className="osp-form-label">Partner Type</span>
          <select name="partnerType" defaultValue="TRAVEL_AGENCY" className="osp-form-select">
            {partnerTypes.map((type) => (
              <option key={type.value} value={type.value}>
                {type.label}
              </option>
            ))}
          </select>
        </label>

        <label className="osp-form-field">
          <span className="osp-form-label">Contact Email</span>
          <input name="contactEmail" type="email" required placeholder="partner@example.com" className="osp-form-input" />
        </label>

        <label className="osp-form-field">
          <span className="osp-form-label">Contact Mobile</span>
          <input name="contactMobile" placeholder="+63..." className="osp-form-input" />
        </label>

        <label className="osp-form-field">
          <span className="osp-form-label">Company Name</span>
          <input name="companyName" placeholder="Registered company or operating name" className="osp-form-input" />
        </label>

        <label className="osp-form-field">
          <span className="osp-form-label">Website / Booking Page</span>
          <input name="websiteUrl" placeholder="https://..." className="osp-form-input" />
        </label>

        <label className="osp-form-field">
          <span className="osp-form-label">Country</span>
          <input name="countryCode" placeholder="PH" maxLength={2} className="osp-form-input" />
        </label>

        <label className="osp-form-field osp-form-field-full">
          <span className="osp-form-label">Booking / Integration Use Case</span>
          <textarea
            name="notes"
            placeholder="Tell us how your team plans to connect bookings, travelers, operator services, or API workflows into One Siargao Pass."
            className="osp-form-textarea"
          />
        </label>
      </div>

      <div className="osp-form-note">
        Partner access is reviewed before activation. API tokens, sandbox access, and production booking-to-pass workflows are not issued automatically from this form.
      </div>

      {state.status !== "idle" ? (
        <div
          className={[
            "osp-form-alert",
            state.status === "success"
              ? "osp-form-alert-success"
              : state.status === "error"
                ? "osp-form-alert-error"
                : "osp-form-alert-pending",
          ].join(" ")}
        >
          <p>{state.message}</p>
          {state.status === "success" && state.applicationId ? (
            <p>Application ID: {state.applicationId}</p>
          ) : null}
        </div>
      ) : null}

      <button type="submit" disabled={state.status === "submitting"} className="osp-form-submit">
        {state.status === "submitting" ? "Submitting..." : "Submit Partner Request"}
      </button>
    </form>
  );
}
