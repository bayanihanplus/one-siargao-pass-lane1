// ============================================================================
// SPM-05A — Passport Trails Product + Pricing Schema Foundation
// Doctrine lock:
// - Product categories: Siargao Partner Tour, Passport Trails™ Curated Tour,
//   Build Your Own Passport Trail.
// - SPM curates, OTA distributes, approved local partners fulfill.
// - Pricing logic is schema-level now; Operator Dashboard price input comes later.
// - No separate QR domain. Trail bookings attach into existing OspQrEvent trailBookingId.
// ============================================================================

enum SpmTrailProductType {
  SIARGAO_PARTNER_TOUR
  PASSPORT_TRAILS_CURATED_TOUR
  DIY_PASSPORT_TRAIL
  ADD_ON
}

enum SpmCurationSource {
  OPERATOR_CREATED
  SPM_CURATED
  ADMIN_CREATED
  TRAVELER_CREATED
}

enum SpmDistributionChannel {
  SPM
  OPERATOR_WEBSITE
  OTA_PARTNER
  TRAVEL_AGENCY
  HOTEL_DESK
  WALK_IN
  AFFILIATE
  ADMIN_CREATED
}

enum SpmFulfillmentPartnerType {
  LOCAL_OPERATOR
  APPROVED_GUIDE
  TRANSPORT_PARTNER
  RESTAURANT_PARTNER
  COMMUNITY_PARTNER
  SURF_SCHOOL
  ADVENTURE_PARTNER
  SELF_GUIDED_QR
}

enum SpmPricingMode {
  FIXED_PER_HEAD
  PAX_TIERED_PER_HEAD
  PACKAGE_FLAT_RATE
  FILLABLE_PRICE_REQUIRED
  REQUEST_TO_CONFIRM
  ADD_ON_PRICE
  DISCOUNT_RULE
  PRICE_RANGE
  PACKAGE_INCLUSION
}

enum SpmBookabilityStatus {
  INSTANT_BOOK
  REQUEST_TO_CONFIRM
  SAVE_ONLY
  NOT_BOOKABLE
  DISABLED_PENDING_PRICE
  DISABLED_PENDING_APPROVAL
}

enum SpmTrailBookingStatus {
  DRAFT
  REQUESTED
  PENDING_OPERATOR_CONFIRMATION
  CONFIRMED
  PAYMENT_PENDING
  PAID
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum SpmDiscountType {
  FIXED_AMOUNT_PER_HEAD
  FIXED_PACKAGE_AMOUNT
  PERCENTAGE
}

