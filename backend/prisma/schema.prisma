generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRAVELER
  OPERATOR_OWNER
  OPERATOR_MANAGER
  OPERATOR_STAFF
  GUIDE
  ADMIN
  SILENT_LGU_ANALYTICS
  LGU_FEE_EDITOR
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum TripStatus {
  DRAFT
  REGISTERED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  INCOMPLETE
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ClearanceStatus {
  PENDING
  APPROVED
  DENIED
  NEEDS_CHANGES
}

enum PassStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUSPENDED
}

enum BookingSource {
  OSP
  OTA
  INTERNATIONAL_OTA
  DIRECT_OPERATOR
  MANUAL
  PRE_OSP
  TRAVELER_CLAIMED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ManifestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  NEEDS_CHANGES
  CANCELLED
}

enum ValidationResult {
  VALID
  INVALID
  DUPLICATE
  LATE
  OVERRIDDEN
  MANIFEST_ISSUE
}

enum PaymentIntentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentState {
  UNPAID
  PAID
}

enum PaymentEventType {
  PAYMENT_INTENT_CREATED
  PAYMENT_CONFIRMATION_RECEIVED
  PAYMENT_MARKED_PAID
}

model User {
  id                String        @id @default(cuid())
  email             String?       @unique
  mobileNumber      String?       @unique
  passwordHash      String?
  fullName          String
  displayName       String?
  accountStatus     AccountStatus @default(ACTIVE)
  primaryRole       UserRole
  preferredLanguage String        @default("en")
  isEmailVerified   Boolean       @default(false)
  isMobileVerified  Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  travelerProfile   TravelerProfile?
  operatorProfile   OperatorProfile?
  guideProfile      GuideProfile?
  emergencyContacts EmergencyContact[]
  notificationPref  NotificationPreference?
  trips             Trip[]                  @relation("TravelerTrips")
  createdActivities ActivityTemplate[]      @relation("ActivityOwner")
  createdManifests  Manifest[]              @relation("ManifestOperator")
  notifications     Notification[]
}

model TravelerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  nationalityCode String?
  birthDate       DateTime?
  homeCountry     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OperatorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  businessName       String
  displayName        String
  contactEmail       String?
  contactMobile      String?
  onboardingStatus   String
  verificationStatus String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuideProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  guideDisplayName   String
  biography          String?
  onboardingStatus   String
  verificationStatus String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id            String   @id @default(cuid())
  userId        String
  contactName   String
  contactMobile String
  relationship  String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  allowInApp     Boolean  @default(true)
  allowEmail     Boolean  @default(true)
  allowMessenger Boolean  @default(false)
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trip {
  id                        String             @id @default(cuid())
  travelerUserId            String
  tripTitle                 String?
  arrivalDate               DateTime
  departureDate             DateTime
  originLocation            String?
  declaredAccommodationName String?
  tripStatus                TripStatus         @default(DRAFT)
  registrationStatus        RegistrationStatus @default(INCOMPLETE)
  clearanceStatus           ClearanceStatus    @default(PENDING)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  traveler         User                 @relation("TravelerTrips", fields: [travelerUserId], references: [id], onDelete: Cascade)
  registration     TripRegistration?
  members          TripMember[]
  consents         TripConsent[]
  pass             OspPass?
  bookingLinks     BookingLink[]
  manifestMembers  ManifestMember[]
  clearanceHistory TripClearanceState[]
}

model TripRegistration {
  id                      String    @id @default(cuid())
  tripId                  String    @unique
  registrationReference   String    @unique
  registrationChannel     String
  registrationCompletedAt DateTime?
  createdAt               DateTime  @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripMember {
  id                String   @id @default(cuid())
  tripId            String
  memberType        String
  linkedUserId      String?
  fullName          String
  nationalityCode   String?
  age               Int?
  passportOrIdHint  String?
  isPrimaryTraveler Boolean  @default(false)
  createdAt         DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripConsent {
  id                String   @id @default(cuid())
  tripId            String
  consentType       String
  consentedByUserId String
  consentedAt       DateTime @default(now())
  metadataJson      Json?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripClearanceState {
  id              String          @id @default(cuid())
  tripId          String
  clearanceStatus ClearanceStatus
  clearanceReason String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model OspPass {
  id         String     @id @default(cuid())
  tripId     String     @unique
  passCode   String     @unique
  passStatus PassStatus @default(ACTIVE)
  issuedAt   DateTime   @default(now())
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  trip            Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  qrCredential    QrCredential?
  backupCodes     BackupCode[]
  offlinePayloads OfflinePassPayload[]
}

model QrCredential {
  id                String    @id @default(cuid())
  ospPassId         String    @unique
  qrToken           String    @unique
  qrVersion         Int       @default(1)
  lastRegeneratedAt DateTime?
  createdAt         DateTime  @default(now())

  ospPass OspPass @relation(fields: [ospPassId], references: [id], onDelete: Cascade)
}

model BackupCode {
  id         String   @id @default(cuid())
  ospPassId  String
  backupCode String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  ospPass OspPass @relation(fields: [ospPassId], references: [id], onDelete: Cascade)
}

model OfflinePassPayload {
  id             String   @id @default(cuid())
  ospPassId      String
  payloadVersion Int
  payloadJson    Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  ospPass OspPass @relation(fields: [ospPassId], references: [id], onDelete: Cascade)
}

model ActivityTemplate {
  id                String   @id @default(cuid())
  ownerUserId       String
  title             String
  description       String?
  durationMinutes   Int?
  meetingPointText  String?
  requiresManifest  Boolean  @default(false)
  requiresGuide     Boolean  @default(false)
  isPubliclyVisible Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner     User               @relation("ActivityOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  instances ActivityInstance[]
}

model ActivityInstance {
  id                 String    @id @default(cuid())
  activityTemplateId String
  scheduledDate      DateTime
  startTime          DateTime?
  endTime            DateTime?
  capacity           Int?
  bookedCount        Int       @default(0)
  instanceStatus     String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  activityTemplate ActivityTemplate @relation(fields: [activityTemplateId], references: [id], onDelete: Cascade)
  manifests        Manifest[]
  bookingItems     BookingItem[]
}

model Booking {
  id                    String        @id @default(cuid())
  primaryTravelerUserId String?
  bookingReference      String        @unique
  bookingSource         BookingSource
  bookingStatus         BookingStatus @default(PENDING)
  bookingTotalPhp       Decimal?      @db.Decimal(12, 2)
  currencyCode          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items          BookingItem[]
  links          BookingLink[]
  externalLinks  ExternalBookingLink[]
  paymentState   PaymentStateRecord?
  paymentIntents PaymentIntent[]
  paymentEvents  PaymentEventLedger[]
}

model BookingItem {
  id                 String   @id @default(cuid())
  bookingId          String
  itemType           String
  activityInstanceId String?
  quantity           Int?
  unitPricePhp       Decimal? @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  booking          Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activityInstance ActivityInstance? @relation(fields: [activityInstanceId], references: [id], onDelete: SetNull)
}

model BookingLink {
  id                String   @id @default(cuid())
  bookingId         String
  tripId            String
  linkedByUserId    String?
  linkMethod        String
  verificationState String
  createdAt         DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([bookingId, tripId])
}

model ExternalBookingLink {
  id                  String    @id @default(cuid())
  bookingId           String
  externalPartnerCode String?
  externalReference   String
  sourcePlatformName  String?
  claimedByUserId     String?
  operatorConfirmedBy String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentIntent {
  id              String              @id @default(cuid())
  bookingId       String
  intentReference String              @unique
  amountPhp       Decimal             @db.Decimal(12, 2)
  currencyCode    String
  status          PaymentIntentStatus @default(PENDING)
  provider        String?
  createdByUserId String?
  confirmedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model PaymentStateRecord {
  id                  String       @id @default(cuid())
  bookingId           String       @unique
  state               PaymentState @default(UNPAID)
  paidAmountPhp       Decimal?     @db.Decimal(12, 2)
  unpaidAmountPhp     Decimal?     @db.Decimal(12, 2)
  lastPaymentIntentId String?
  stateUpdatedAt      DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model PaymentEventLedger {
  id              String           @id @default(cuid())
  bookingId       String
  paymentIntentId String?
  eventType       PaymentEventType
  eventKey        String           @unique
  source          String
  payloadJson     Json?
  processedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([paymentIntentId])
}

model ValidationAttempt {
  id                 String           @id @default(cuid())
  ospPassId          String
  activityInstanceId String?
  manifestId         String?
  scannedByUserId    String?
  validationResult   ValidationResult
  contextJson        Json?
  createdAt          DateTime         @default(now())
}

model CheckinEvent {
  id                 String   @id @default(cuid())
  tripId             String
  bookingId          String?
  activityInstanceId String?
  checkedInByUserId  String?
  checkinStatus      String
  createdAt          DateTime @default(now())
}

model Manifest {
  id                 String         @id @default(cuid())
  activityInstanceId String
  operatorUserId     String?
  manifestReference  String         @unique
  manifestStatus     ManifestStatus @default(DRAFT)
  totalMembers       Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  activityInstance ActivityInstance          @relation(fields: [activityInstanceId], references: [id], onDelete: Cascade)
  operator         User?                     @relation("ManifestOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  members          ManifestMember[]
  submissions      ManifestSubmission[]
  approvalRequests ManifestApprovalRequest[]
}

model ManifestMember {
  id                   String   @id @default(cuid())
  manifestId           String
  tripId               String?
  bookingId            String?
  travelerNameSnapshot String
  memberStatus         String
  createdAt            DateTime @default(now())

  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  trip     Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
}

model ManifestSubmission {
  id                String   @id @default(cuid())
  manifestId        String
  submittedByUserId String
  submissionTime    DateTime @default(now())
  submissionNotes   String?
  createdAt         DateTime @default(now())

  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
}

model ManifestApprovalRequest {
  id            String         @id @default(cuid())
  manifestId    String
  requestStatus ManifestStatus @default(UNDER_REVIEW)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime       @default(now())

  manifest Manifest                 @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  actions  ManifestApprovalAction[]
}

model ManifestApprovalAction {
  id                        String   @id @default(cuid())
  manifestApprovalRequestId String
  actionType                String
  actedByUserId             String
  actionNotes               String?
  createdAt                 DateTime @default(now())

  manifestApprovalRequest ManifestApprovalRequest @relation(fields: [manifestApprovalRequestId], references: [id], onDelete: Cascade)
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  notificationType String
  title            String
  body             String
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QrEvent {
  id                  String   @id @default(cuid())
  eventType           String
  travelerId          String?
  tripId              String?
  passId              String?
  qrCredentialId      String?
  effectivePassStatus String?
  scannerActorId      String?
  scannerActorRole    String?
  contextType         String
  contextReferenceId  String?
  outcome             String
  reasonCode          String?
  reasonMessage       String?
  createdAt           DateTime @default(now())
}

enum OperatorAccessStatus {
  BLOCKED
  ALLOWED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
}

model OperatorAccessRecord {
  id                    String               @id @default(cuid())
  travelerId            String
  tripId                String
  bookingId             String?
  manifestId            String?
  manifestMemberId      String?
  operatorUserId        String
  activityTemplateId    String
  activityInstanceId    String
  accessChannel         String
  accessStatus          OperatorAccessStatus
  sourceQrEventId       String
  scannedQrCredentialId String?
  scannedByUserId       String
  scannedByRole         String
  reasonCode            String?
  reasonMessage         String?
  occurredAt            DateTime
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([operatorUserId, activityInstanceId, occurredAt])
  @@index([travelerId, activityInstanceId, occurredAt])
}

model GuideAssignment {
  id                 String   @id @default(cuid())
  operatorUserId     String
  guideUserId        String?
  guideNameSnapshot  String
  activityInstanceId String?
  basePayAmount      Int?
  tipAmount          Int?
  commissionAmount   Int?
  paymentStatus      String   @default("PENDING")
  paymentMethod      String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([operatorUserId, activityInstanceId])
  @@index([guideUserId])
}

model OperatorMembership {
  id             String   @id @default(cuid())
  operatorUserId String
  memberUserId   String
  workspaceRole  String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([operatorUserId, memberUserId])
  @@index([memberUserId])
  @@index([operatorUserId])
}

// === LANE 2-A: QR COMPLIANCE + PASSPORT TRAILS FOUNDATION ===

enum OspQrEventType {
  TRAVELER_INGRESS_SCAN
  TRAVELER_EGRESS_SCAN
  INTER_ISLAND_DEPARTURE_SCAN
  INTER_ISLAND_ARRIVAL_SCAN
  BOAT_BOARDING_SCAN
  BOAT_DISEMBARKATION_SCAN
  ACTIVITY_CHECK_IN_SCAN
  ACTIVITY_CHECK_OUT_SCAN
  OPERATOR_ACCESS_SCAN
  GUIDE_VALIDATION_SCAN
  PARTNER_NODE_CHECK_IN_SCAN
  PASSPORT_STAMP_SCAN
  MANIFEST_PARTICIPATION_SCAN
  COMPLIANCE_EXCEPTION_SCAN
}

enum OspCheckpointType {
  AIRPORT
  SEAPORT
  BOAT_DEPARTURE
  BOAT_ARRIVAL
  ISLAND_STOP
  ACTIVITY_SITE
  OPERATOR_SITE
  GUIDE_SITE
  PARTNER_SITE
  RESTAURANT_NODE
  COMMUNITY_NODE
  SCENIC_NODE
  ADMIN_CHECKPOINT
}

enum OspQrDirection {
  INGRESS
  EGRESS
  DEPARTURE
  ARRIVAL
  CHECK_IN
  CHECK_OUT
  BOARDING
  DISEMBARKATION
  VALIDATION
}

enum OspQrOutcome {
  ALLOWED
  BLOCKED
  REGULARIZATION_REQUIRED
  MANIFEST_REQUIRED
  PASS_NOT_FOUND
  PASS_EXPIRED
  PAYMENT_PENDING
  OPERATOR_NOT_APPROVED
  BOOKING_NOT_FOUND
  WRONG_OPERATOR
  WRONG_ACTIVITY_INSTANCE
  ALREADY_CHECKED_IN
  ALREADY_COMPLETED
  MANUAL_REVIEW_REQUIRED
}

enum InterIslandMovementStatus {
  PLANNED
  BOARDING
  DEPARTED
  ARRIVED
  RETURNING
  COMPLETED
  BLOCKED
  CANCELLED
  MANUAL_REVIEW
}

enum ComplianceExceptionType {
  QR_NOT_FOUND
  PASS_EXPIRED
  NO_VALID_BOOKING
  NO_MANIFEST
  WRONG_OPERATOR
  PAYMENT_PENDING
  UNAPPROVED_OPERATOR
  UNREGISTERED_VESSEL
  MANUAL_ENTRY_REQUIRED
  SAFETY_BLOCK
  DOT_LGU_REVIEW_REQUIRED
}

enum ComplianceExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceResolutionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum SpmTrailFamilyCode {
  ISLAND_HOPPING
  SURF_EXPLORER
  NORTH_SIARGAO
  INLAND_DISCOVERY
  CULTURE_COMMUNITY
  SUNSET_SCENIC
  ADVENTURE
  RETURN_TRAVELER_CONTINUITY
}

enum SpmTrailNodeType {
  PLACE
  ACTIVITY
  RESTAURANT
  COMMUNITY
  SCENIC
  SURF
  ADVENTURE
  TRANSPORT
  MILESTONE
  CONDITIONAL_PACKAGE_NODE
}

enum SpmNodeRequirementType {
  FREE_PUBLIC_NODE
  QR_STAMP_NODE
  BOOKING_REQUIRED_NODE
  GUIDE_RECOMMENDED_NODE
  GUIDE_REQUIRED_NODE
  OPERATOR_REQUIRED_NODE
  PARTNER_SITE_NODE
  RESTAURANT_PARTNER_NODE
  REQUEST_TO_CONFIRM_NODE
  PACKAGE_ONLY_NODE
  TRANSPORT_REQUIRED_NODE
  SAFETY_CONTROLLED_NODE
}

enum SpmApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

model OspQrEvent {
  id                  String             @id @default(cuid())
  eventType           OspQrEventType
  travelerUserId      String?
  tripId              String?
  passId              String?
  qrCredentialId      String?
  bookingId           String?
  trailBookingId      String?
  manifestId          String?
  operatorUserId      String?
  guideProfileId      String?
  partnerId           String?
  vesselId            String?
  checkpointId        String?
  checkpointType      OspCheckpointType?
  direction           OspQrDirection?
  locationLabel       String?
  latitude            Float?
  longitude           Float?
  scannerActorId      String?
  scannerActorRole    String?
  scanChannel         String?
  effectivePassStatus String?
  paymentStatus       String?
  manifestStatus      String?
  outcome             OspQrOutcome
  reasonCode          String?
  reasonMessage       String?
  occurredAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())

  @@index([eventType])
  @@index([tripId])
  @@index([passId])
  @@index([qrCredentialId])
  @@index([checkpointId])
  @@index([operatorUserId])
  @@index([occurredAt])
  @@map("osp_qr_events")
}

model OspCheckpoint {
  id                       String            @id @default(cuid())
  code                     String            @unique
  name                     String
  checkpointType           OspCheckpointType
  locationLabel            String?
  municipality             String?
  barangay                 String?
  latitude                 Float?
  longitude                Float?
  isActive                 Boolean           @default(true)
  requiresManifest         Boolean           @default(false)
  requiresBooking          Boolean           @default(false)
  requiresOperator         Boolean           @default(false)
  requiresPaymentClearance Boolean           @default(false)
  supportsIngress          Boolean           @default(false)
  supportsEgress           Boolean           @default(false)
  supportsInterIsland      Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([checkpointType])
  @@index([isActive])
  @@map("osp_checkpoints")
}

model OspVessel {
  id                       String   @id @default(cuid())
  operatorUserId           String
  vesselName               String
  vesselRegistrationNumber String?
  vesselType               String?
  capacity                 Int?
  complianceStatus         String   @default("PENDING_REVIEW")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([operatorUserId])
  @@index([complianceStatus])
  @@map("osp_vessels")
}

model InterIslandMovement {
  id                      String                    @id @default(cuid())
  tripId                  String?
  bookingId               String?
  trailBookingId          String?
  manifestId              String?
  operatorUserId          String?
  vesselId                String?
  originCheckpointId      String?
  destinationCheckpointId String?
  departureQrEventId      String?
  arrivalQrEventId        String?
  returnQrEventId         String?
  movementStatus          InterIslandMovementStatus @default(PLANNED)
  scheduledDepartureAt    DateTime?
  actualDepartureAt       DateTime?
  actualArrivalAt         DateTime?
  actualReturnAt          DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([tripId])
  @@index([manifestId])
  @@index([operatorUserId])
  @@index([vesselId])
  @@index([movementStatus])
  @@map("inter_island_movements")
}

model ComplianceException {
  id               String                      @id @default(cuid())
  qrEventId        String?
  travelerUserId   String?
  tripId           String?
  operatorUserId   String?
  checkpointId     String?
  exceptionType    ComplianceExceptionType
  severity         ComplianceExceptionSeverity @default(MEDIUM)
  resolutionStatus ComplianceResolutionStatus  @default(OPEN)
  resolutionNotes  String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime                    @default(now())

  @@index([qrEventId])
  @@index([tripId])
  @@index([operatorUserId])
  @@index([checkpointId])
  @@index([exceptionType])
  @@index([resolutionStatus])
  @@map("compliance_exceptions")
}

model SpmTrailFamily {
  id                String             @id @default(cuid())
  code              SpmTrailFamilyCode @unique
  name              String
  description       String?
  publicLabel       String?
  officialSortOrder Int
  isActive          Boolean            @default(true)
  isOfficial        Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([isActive])
  @@index([isOfficial])
  @@map("spm_trail_families")
}

model SpmTrailTrack {
  id            String   @id @default(cuid())
  trailFamilyId String
  code          String   @unique
  name          String
  description   String?
  isPublic      Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([trailFamilyId])
  @@index([isActive])
  @@map("spm_trail_tracks")
}

model SpmTrailNode {
  id                String                 @id @default(cuid())
  trailFamilyId     String
  trailTrackId      String?
  code              String                 @unique
  name              String
  description       String?
  nodeType          SpmTrailNodeType
  requirementType   SpmNodeRequirementType
  approvalStatus    SpmApprovalStatus      @default(DRAFT)
  isOfficialNode    Boolean                @default(false)
  isCandidateNode   Boolean                @default(false)
  isConditionalNode Boolean                @default(false)
  conditionNote     String?
  latitude          Float?
  longitude         Float?
  locationLabel     String?
  municipality      String?
  barangay          String?
  publicAccessLevel String?
  stampEligible     Boolean                @default(false)
  bookingRequired   Boolean                @default(false)
  operatorRequired  Boolean                @default(false)
  guideRequirement  String?
  safetyControlled  Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([trailFamilyId])
  @@index([trailTrackId])
  @@index([approvalStatus])
  @@index([isOfficialNode])
  @@index([isCandidateNode])
  @@index([stampEligible])
  @@map("spm_trail_nodes")
}

model SpmTrailVariant {
  id                   String   @id @default(cuid())
  trailFamilyId        String
  code                 String   @unique
  name                 String
  description          String?
  variantType          String?
  isActive             Boolean  @default(true)
  isPublic             Boolean  @default(false)
  minimumRequiredNodes Int?
  completionRuleJson   Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([trailFamilyId])
  @@index([isActive])
  @@map("spm_trail_variants")
}

model SpmTrailVariantNode {
  id             String   @id @default(cuid())
  trailVariantId String
  trailNodeId    String
  isRequired     Boolean  @default(false)
  isOptional     Boolean  @default(false)
  isConditional  Boolean  @default(false)
  sortOrder      Int      @default(0)
  conditionNote  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([trailVariantId, trailNodeId])
  @@index([trailVariantId])
  @@index([trailNodeId])
  @@map("spm_trail_variant_nodes")
}

model OspComplianceFeeProgram {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  scopeType      String
  municipality   String?
  barangay       String?
  checkpointId   String?
  appliesToRoute String?
  approvalStatus String    @default("DRAFT")
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  feeItems OspComplianceFeeItem[]

  @@index([scopeType])
  @@index([municipality])
  @@index([barangay])
  @@index([checkpointId])
  @@index([approvalStatus])
  @@index([isActive])
  @@map("osp_compliance_fee_programs")
}

model OspComplianceFeeItem {
  id                    String   @id @default(cuid())
  feeProgramId          String
  code                  String
  name                  String
  description           String?
  feeCategory           String
  chargeBasis           String
  amountPhp             Decimal? @db.Decimal(12, 2)
  isRequiredForApproval Boolean  @default(true)
  isLguFillable         Boolean  @default(true)
  isTravelerFacing      Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  feeProgram OspComplianceFeeProgram @relation(fields: [feeProgramId], references: [id], onDelete: Cascade)

  @@unique([feeProgramId, code])
  @@index([feeProgramId])
  @@index([feeCategory])
  @@index([chargeBasis])
  @@index([isRequiredForApproval])
  @@index([isLguFillable])
  @@map("osp_compliance_fee_items")
}

model OspFeeChangeAudit {
  id                          String   @id @default(cuid())
  actorUserId                 String?
  actorRole                   String?
  feeProgramId                String
  feeItemId                   String
  feeItemCodeSnapshot         String
  feeItemNameSnapshot         String
  previousAmountPhp           Decimal? @db.Decimal(12, 2)
  newAmountPhp                Decimal? @db.Decimal(12, 2)
  previousDescription         String?
  newDescription              String?
  previousRequiredForApproval Boolean
  newRequiredForApproval      Boolean
  previousTravelerFacing      Boolean
  newTravelerFacing           Boolean
  changeReason                String?
  createdAt                   DateTime @default(now())

  @@index([actorUserId])
  @@index([actorRole])
  @@index([feeProgramId])
  @@index([feeItemId])
  @@index([feeItemCodeSnapshot])
  @@index([createdAt])
  @@map("osp_fee_change_audits")
}
